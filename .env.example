# GEMINI_API_KEY: Optional server-side key for Google Gemini API calls.
# Never expose this variable with a VITE_ prefix on the client.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical production URL where this application is hosted.
APP_URL="https://apostlesofdeathmarried.ru"

# SESSION_SECRET: Stable secret (min 32 chars) used to sign stateless session tokens across Vercel serverless instances.
# If omitted, a deterministic key is derived from SUPABASE_SERVICE_ROLE_KEY or deployment metadata.
SESSION_SECRET=""

# SUPABASE CLOUD PERSISTENCE (Recommended for Vercel Serverless deployments):
# Automatically backs up and restores the SQLite database (data/apostles.db) and uploaded media
# across Vercel cold starts so zero users, posts, comments, XP, or uploads are ever lost.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="apostles-archive-persistence"

# RESEND EMAIL VERIFICATION (6-digit code delivery during registration & profile verification):
# Server-side only — never prefix with VITE_.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@apostlesofdeathmarried.ru"


